{
  "name": "novex-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:cloud": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-cloud-dev.ps1",
    "start:dev:cloud:direct": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-cloud-direct.ps1",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:security": "jest --testPathPattern=test/security",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -P tsconfig.typeorm.json ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create ./src/database/migrations/Migration",
    "migration:generate": "npm run typeorm -- migration:generate ./src/database/migrations/Migration -d ./src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/database/data-source.ts",
    "seed:operaciones": "ts-node -P tsconfig.typeorm.json ./src/database/seeds/run-seed-operaciones.ts",
    "seed:rbac": "ts-node -P tsconfig.typeorm.json ./src/database/seeds/run-seed-rbac.ts",
    "seed:situations:mock": "ts-node -P tsconfig.typeorm.json ./src/database/seeds/run-seed-situations-mock.ts",
    "seed:situations:clear": "ts-node -P tsconfig.typeorm.json ./src/database/seeds/run-clear-situations-mock.ts",
    "sync:users:cloud": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-users-from-cloud.ps1",
    "sync:users:cloud:run": "ts-node -P tsconfig.typeorm.json ./src/database/seeds/run-sync-users-from-cloud.ts",
    "cloud:user:upsert": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/upsert-cloud-user.ps1",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "cloud:proxy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-cloud-sql-proxy.ps1",
    "cloud:psql": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/cloud-db-shell.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
