# =============================================================================
# Cunmark Backend — plantilla de entorno local con Docker
# =============================================================================
# 1. Copiar este archivo:  cp .env.example .env
# 2. Levantar infraestructura:  docker compose up -d
# 3. Arrancar NestJS en el host:  npm run start:dev
# =============================================================================

# -----------------------------------------------------------------------------
# NestJS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose + TypeORM en el host)
# -----------------------------------------------------------------------------
# NestJS corre fuera de Docker y se conecta al puerto publicado en localhost.
# Los valores DB_* deben coincidir con POSTGRES_* del servicio postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cunmark
DB_PASSWORD=cunmark
DB_DATABASE=cunmark

# true solo en desarrollo local: TypeORM crea/actualiza tablas automáticamente.
# En producción / Cloud SQL debe ser false y usar migraciones.
DB_SYNCHRONIZE=true
DB_LOGGING=true

# -----------------------------------------------------------------------------
# Docker Compose — servicio postgres
# -----------------------------------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_USER=cunmark
POSTGRES_PASSWORD=cunmark
POSTGRES_DB=cunmark
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Docker Compose — servicio pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_VERSION=latest
PGADMIN_DEFAULT_EMAIL=admin@cunmark.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Semillas de datos
# -----------------------------------------------------------------------------
# Solo CatalogSeedService está activo al arrancar (catálogos de producción).
# DemoSeedService permanece deshabilitado; no usar en ningún entorno.
DEMO_SEED_ENABLED=false

# -----------------------------------------------------------------------------
# JWT (autenticación)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-local-development
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Google (inicio de sesión)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Gemini (opcional al arrancar; requerida en /intelligence/interpret*)
# -----------------------------------------------------------------------------
# Obtén la key en https://aistudio.google.com/apikey
# No uses comillas alrededor del valor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
