# =============================================================================
# Novex Backend — plantilla de entorno local con Docker
# =============================================================================
# 1. Copiar este archivo:  cp .env.example .env
# 2. Levantar infraestructura:  docker compose up -d
# 3. Arrancar NestJS en el host:  npm run start:dev
# =============================================================================

# -----------------------------------------------------------------------------
# NestJS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
# Opcional en local; por defecto permite localhost:5173 y 127.0.0.1:5173.
CORS_ORIGINS=
# true añade mensajes [BOOT X] de diagnóstico durante el arranque.
# En development el logger de Nest ya muestra rutas y módulos con colores.
BOOT_VERBOSE=false
# true registra cada request HTTP como JSON (útil en producción / Cloud Logging).
# Por defecto: false en development, true en production.
HTTP_REQUEST_LOGGING=false

# -----------------------------------------------------------------------------
# PostgreSQL — cambio local / Cloud SQL
# -----------------------------------------------------------------------------
# Cambia SOLO DB_CLOUD y reinicia el backend (npm run start:dev).
#   DB_CLOUD=false  → Docker local (novex-postgres)
#   DB_CLOUD=true   → Cloud SQL (IP pública + SSL; tu IP debe estar autorizada)
#
# Equivale a comentar una línea:
#   DB_CLOUD=false
#   # DB_CLOUD=true
# -----------------------------------------------------------------------------
DB_CLOUD=false
# DB_CLOUD=true

# --- LOCAL (DB_CLOUD=false) ---
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432
DB_USERNAME_LOCAL=novex
DB_PASSWORD_LOCAL=novex
DB_DATABASE_LOCAL=novex
DB_SSL_LOCAL=false

# --- CLOUD SQL (DB_CLOUD=true) ---
# IP pública de novex-db. Password = Secret Manager novex-db-password.
DB_HOST_CLOUD=34.31.17.63
DB_PORT_CLOUD=5432
DB_USERNAME_CLOUD=novex
DB_PASSWORD_CLOUD=cambiar-con-secret-novex-db-password
DB_DATABASE_CLOUD=novex
DB_SSL_CLOUD=true

# Compatibilidad con scripts antiguos y TypeORM CLI.
# No editar a mano: se rellenan al arrancar según DB_CLOUD.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=novex
DB_PASSWORD=novex
DB_DATABASE=novex

# false: el esquema se administra exclusivamente con migraciones TypeORM
# (npm run migration:run). synchronize está desactivado de forma permanente.
DB_SYNCHRONIZE=false
DB_LOGGING=false
# true/false fuerza SSL; sin definir, producción usa SSL automáticamente.
DB_SSL=false

# -----------------------------------------------------------------------------
# Docker Compose — servicio postgres
# -----------------------------------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_USER=novex
POSTGRES_PASSWORD=novex
POSTGRES_DB=novex
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Docker Compose — servicio pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_VERSION=latest
PGADMIN_DEFAULT_EMAIL=admin@novex.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Semillas de datos
# -----------------------------------------------------------------------------
# Solo CatalogSeedService está activo al arrancar (catálogos de producción).
# DemoSeedService permanece deshabilitado; no usar en ningún entorno.
DEMO_SEED_ENABLED=false
# En producción debe habilitarse explícitamente para ejecutar CatalogSeedService.
CATALOG_SEED_ON_BOOT=false

# -----------------------------------------------------------------------------
# JWT (autenticación)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-local-development
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Google (inicio de sesión)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Login por correo (solo desarrollo local)
# -----------------------------------------------------------------------------
# true = permite POST /auth/email sin OAuth.
# En staging/producción omitir o false (solo Google).
ENABLE_EMAIL_LOGIN=true

# -----------------------------------------------------------------------------
# Gemini (opcional al arrancar; requerida en /intelligence/interpret*)
# -----------------------------------------------------------------------------
# Obtén la key en https://aistudio.google.com/apikey
# No uses comillas alrededor del valor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Tiempo máximo (ms) para una operación interactiva de análisis IA (default 60000).
GEMINI_TIMEOUT_MS=60000
