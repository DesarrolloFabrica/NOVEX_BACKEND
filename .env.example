# Cunmark Backend — variables de entorno (Sprint 6)
# Copiar a .env y ajustar según el entorno local.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# PostgreSQL
# Defaults de nueva instalación. Si ya tienes rol/base `omega` en local,
# mantén esos valores en tu .env (no se renombra infraestructura automáticamente).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cunmark
DB_PASSWORD=cunmark
DB_DATABASE=cunmark
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Gemini (Sprint 7) — requerida solo al llamar /intelligence/interpret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
